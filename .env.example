# Qdrant — pick ONE:
#   Qdrant Cloud / remote server
QDRANT_URL=
QDRANT_API_KEY=
#   or embedded local storage (no server, no Docker): leave QDRANT_URL empty
# QDRANT_PATH=qdrant_local
#   (neither set -> localhost:6333 from docker compose)

# Retrieval engine served by the API: v2 (hybrid, default) | v1 (baseline)
RETRIEVAL_ENGINE=v2
# Abstention thresholds (calibrated by eval/run_eval.py --calibrate)
# V2_NIIMH_THRESHOLD=0.55
# V2_PATENT_THRESHOLD=0.55

# CORS — comma-separated origins for deployment (default *)
# ALLOWED_ORIGINS=https://your-frontend.example

# Optional LLM gloss (enrich_chunks.py) — both free
OLLAMA_URL=http://localhost:11434
# GEMINI_API_KEY=   # free key: https://aistudio.google.com/apikey
